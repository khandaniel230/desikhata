                    </div>
                </div>
                <a href="finance.html" class="view-all">View All Finance Calculators <i class="fas fa-chevron-right"></i></a>
            </div>

            <!-- Math Calculators Card -->
            <div class="category-card math-category">
                <div class="category-header">
                    <div class="category-icon">
                        <i class="fas fa-square-root-alt"></i>
                    </div>
