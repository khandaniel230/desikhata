                <img src="https://placehold.co/400x600" alt="CalcMaster Mobile App">
            </div>
        </div>
    </div>
</section>



calculators catagories
 <section class="categories" id="categories">
    <div class="container">
        <div class="section-header">
            <h2>Calculator Categories</h2>
            <p>Browse our specialized calculators by category</p>
        </div>
        <div class="category-grid">
            <!-- Health Calculators Card -->
            <div class="category-card health-category">
                <div class="category-header">
                    <div class="category-icon">
                        <i class="fas fa-heart-pulse"></i>
                    </div>
                    <h3>Health Calculators</h3>
                </div>
                <div class="category-content">
                    <div class="calculator-card">
                        <div class="card-icon bg-pink">
                            <i class="fas fa-weight-scale"></i>
                        </div>
                        <div class="card-content">
                            <h4>BMI Calculator</h4>
                            <p>Calculate your body mass index</p>
                            <a href="bmi.html" class="card-link">Calculate </a>
                        </div>
                    </div>
                    <div class="calculator-card">
                        <div class="card-icon bg-pink">
                            <i class="fas fa-utensils"></i>
                        </div>
                        <div class="card-content">
                            <h4>Calorie Calculator</h4>
                            <p>Determine your daily calorie needs</p>
                            <a href="calorie.html" class="card-link">Calculate </a>
                        </div>
                    </div>
                    <div class="calculator-card">
                        <div class="card-icon bg-pink">
                            <i class="fas fa-glass-water"></i>
                        </div>
                        <div class="card-content">
                            <h4>Water Intake</h4>
                            <p>Calculate recommended water consumption</p>
                            <a href="water.html" class="card-link">Calculate </a>
                        </div>
                    </div>
                </div>
                <a href="health.html" class="view-all">View All Health Calculators <i class="fas fa-chevron-right"></i></a>
            </div>

            <!-- Finance Calculators Card -->
            <div class="category-card finance-category">
